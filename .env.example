# OpenAI API Key (optional - falls back to rule-based system if not provided)
OPENAI_API_KEY=your_openai_api_key_here

# Yahoo OAuth 2.0
YAHOO_CONSUMER_KEY=your_yahoo_consumer_key
YAHOO_CONSUMER_SECRET=your_yahoo_consumer_secret
# YAHOO_CALLBACK_URL=http://localhost:3000/api/yahoo/callback

# Dev-only: skip the OAuth browser flow by pasting tokens here.
# Do the real OAuth once, grab tokens from browser devtools (Application > Cookies),
# then paste them below. The refresh token keeps you authenticated long-term.
# YAHOO_DEV_ACCESS_TOKEN=
# YAHOO_DEV_REFRESH_TOKEN=

# Sentry (optional - error tracking and monitoring)
# Create a free project at https://sentry.io, grab the DSN from Settings > Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your_sentry_org
# SENTRY_PROJECT=your_sentry_project

# Database (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_copilot
